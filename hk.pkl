// hk — https://hk.jdx.dev — https://github.com/jdx/hk
// Install hooks after clone: `hk install` (or once machine-wide: `hk install --global`).
// Requires on PATH: hk, trufflehog, gitleaks  (e.g. brew install hk trufflehog gitleaks)
amends "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Builtins.pkl"

// Never feed local tooling / caches into file-based steps.
exclude = List(
  "graphify-out",
  "graphify",
  ".tokensave",
  ".serena",
  ".headroom",
  ".omc",
  ".git",
  ".agents/runs",
)

// Secret guards. Check-only — never "fix" secrets.
// Use staged/delta scanners so historical skill docs (example tokens) are not re-flagged every commit.
local secret_steps = new Mapping<String, Step> {
  // Pattern scan of the staged index only.
  ["gitleaks"] {
    check = "gitleaks protect --staged --redact --verbose --no-banner"
    check_first = false
  }

  // Keep the documented manual scan mode: all detector results fail closed without live verification.
  // Clear Git selectors and TruffleHog hook-mode markers before resolving this worktree's HEAD or cloning.
  ["trufflehog"] {
    check = "env -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_CONFIG -u GIT_CONFIG_PARAMETERS -u GIT_CONFIG_COUNT -u GIT_OBJECT_DIRECTORY -u GIT_DIR -u GIT_WORK_TREE -u GIT_IMPLICIT_WORK_TREE -u GIT_GRAFT_FILE -u GIT_INDEX_FILE -u GIT_NO_REPLACE_OBJECTS -u GIT_REPLACE_REF_BASE -u GIT_PREFIX -u GIT_SHALLOW_FILE -u GIT_COMMON_DIR -u PRE_COMMIT -u HUSKY -u HUSKY_GIT_PARAMS -u TRUFFLEHOG_PRE_COMMIT sh -c 'head=$(git rev-parse --verify HEAD) && trufflehog git file://. --since-commit \"$head\" --branch \"$head\" --no-verification --fail --results=verified,unverified,unknown'"
    check_first = false
  }

  // PEM / OpenSSH private keys in staged text files.
  ["detect_private_key"] = Builtins.detect_private_key

  ["check_merge_conflict"] = Builtins.check_merge_conflict
}

hooks {
  ["pre-commit"] {
    fix = false
    stash = "none"
    steps = secret_steps
  }
  ["pre-push"] {
    fix = false
    stash = "none"
    steps = secret_steps
  }
  ["check"] {
    steps = secret_steps
  }
  ["fix"] {
    // Secrets cannot be auto-fixed; still run checks.
    fix = false
    steps = secret_steps
  }
}
